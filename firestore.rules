rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Simple validation for AppData structure
    function isValidAppData(data) {
      return data is map &&
             (data.get('students', []) is list) &&
             (data.get('settings', {}) is map);
    }

    // --- Rules ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      match /appData/data {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidAppData(incoming());
      }

      // Allow owner access to all granular collections
      match /students/{id} {
        allow read, write: if isOwner(userId);
      }
      match /attendance/{id} {
        allow read, write: if isOwner(userId);
      }
      match /expenses/{id} {
        allow read, write: if isOwner(userId);
      }
      match /journal/{id} {
        allow read, write: if isOwner(userId);
      }
      match /dailyTasks/{id} {
        allow read, write: if isOwner(userId);
      }
      match /dpssTopics/{id} {
        allow read, write: if isOwner(userId);
      }
      match /selfLearningTopics/{id} {
        allow read, write: if isOwner(userId);
      }
      match /habitCompletions/{id} {
        allow read, write: if isOwner(userId);
      }
      match /dailyNotes/{id} {
        allow read, write: if isOwner(userId);
      }
    }

    // Helper validation for SharedNote (robust and simple)
    function isValidSharedNote(data) {
      return data is map &&
             data.get('id', '') is string && data.get('id', '').size() <= 128 &&
             data.get('ownerId', '') is string && data.get('ownerId', '').size() <= 128 &&
             data.get('type', '') is string && data.get('type', '').size() <= 100 &&
             data.get('title', '') is string && data.get('title', '').size() <= 500;
    }

    match /sharedNotes/{shareId} {
      allow read: if true; // public read for imported shared links
      allow create: if isValidSharedNote(incoming()) && incoming().id == shareId;
      allow update: if isSignedIn() && isValidSharedNote(incoming()) && incoming().ownerId == existing().ownerId && incoming().id == shareId && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
